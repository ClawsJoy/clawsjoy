{
  "name": "script_generator",
  "type": "atomic",
  "version": "1.0.0",
  "description": "根据主题生成短视频脚本",
  "category": "text",
  "author": "ClawsJoy",
  "tags": ["script", "generation", "text"],
  "input_schema": {
    "topic": {"type": "string", "required": true, "description": "视频主题"},
    "duration": {"type": "integer", "required": false, "default": 30, "description": "视频时长(秒)"}
  },
  "output_schema": {
    "script": {"type": "string", "description": "生成的脚本内容"},
    "topic": {"type": "string", "description": "原始主题"}
  },
  "examples": [
    {"input": {"topic": "上海故事"}, "output": {"script": "..."}}
  ]
}
