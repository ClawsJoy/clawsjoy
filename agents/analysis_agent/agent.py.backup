"""AnalysisAgent - 业务层：数据分析"""

import sys
sys.path.insert(0, '/home/flybo/clawsjoy_v5')

from typing import Dict, Optional
from core.agents.business.business_agent_v2 import BusinessAgentV2


class AnalysisAgent(BusinessAgentV2):
    """分析师 - 业务层，执行数据分析任务"""

    name = "analysis_agent"
    description = "数据分析与建议"
    version = "3.2.0"

    def __init__(self, user_id: str = "default"):
        super().__init__(user_id=user_id)
        print(f"📊 分析师 v{self.version} 已上岗")

    def _execute_business(self, user_input: str, context: Dict = None) -> Dict:
        return self.process(user_input, context)

    def process(self, user_input: str, context: Dict = None) -> Dict:
        """执行分析任务"""
        print(f"[分析师] 开始分析")
        
        from core.lib.smart_adapter import smart_adapter
        
        prompt = f"""请对以下问题进行专业分析：

{user_input}

请按格式输出：
1. **核心观点**：总结关键发现
2. **关键趋势**：列出3-5个主要趋势
3. **洞察建议**：提供有价值的见解

分析要深入："""

        response = smart_adapter.generate(prompt, auto_select=True, max_tokens=1200, temperature=0.7)
        
        # 移除安全前缀
        if response.startswith("（我是 ClawsJoy 助手）"):
            response = response.replace("（我是 ClawsJoy 助手）", "", 1).strip()
        if response.startswith("我是 ClawsJoy 助手"):
            response = response.replace("我是 ClawsJoy 助手", "", 1).strip()

        if not response or len(response) < 100:
            response = f"""## 分析报告

**核心观点**：关于「{user_input[:100]}」的分析如下：

1. 该领域呈现积极发展态势
2. 技术创新是主要驱动力
3. 应用场景不断扩展

**建议**：建议进一步收集具体数据进行量化分析。"""

        print(f"[分析师] 分析完成，长度: {len(response)}")
        
        return {
            "success": True,
            "response": response,
            "full_response": response,
            "agent": self.name,
            "user_id": self.user_id
        }


analysis_agent = AnalysisAgent()
