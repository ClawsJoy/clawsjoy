"""DecisionAgent - 真正的决策者（有记忆、有经验、综合判断）
版本: 5.1.0 - 增量添加多源决策能力，保留稳定基础
"""

import sys
sys.path.insert(0, '/home/flybo/clawsjoy_v5')

import time
from typing import Dict, Optional, List, Tuple
from datetime import datetime
from dataclasses import dataclass, field
from core.agents.business.base_business_agent import BusinessAgent


@dataclass
class DecisionRecord:
    """决策记录"""
    task: str
    decision: str
    result: str  # success/failed/pending
    confidence: float
    timestamp: str
    context: Dict = field(default_factory=dict)


class DecisionAgent(BusinessAgent):
    """
    决策者 - 多源信息综合决策
    
    决策依据（加权）:
    1. 分析师报告 (40%) - 快速理解层分析
    2. 语义引擎 (25%) - 意图识别
    3. LLM 建议 (20%) - 综合评估
    4. 历史经验 (10%) - 过往成功记录
    5. 启发规则 (5%) - 长度等启发
    """

    name = "decision_agent"
    description = "智能决策者 - 多源综合决策"
    version = "5.1.0"

    def __init__(self, user_id: str = "default"):
        super().__init__(user_id=user_id)
        self._init_components()
        self._load_memory()
        print(f"🎖️ 决策者 v{self.version} 已上岗 (经验记忆: {len(self._decision_memory)}条)")

    def _init_components(self):
        """初始化所有组件"""
        # 1. 推理引擎
        try:
            from engine.reasoning import reasoning_engine
            self.reasoning_engine = reasoning_engine
        except Exception as e:
            print(f"[决策者] 推理引擎加载失败: {e}")
            self.reasoning_engine = None
        
        # 2. 语义引擎
        try:
            from engine.semantic import semantic_engine
            self.semantic_engine = semantic_engine
        except Exception as e:
            print(f"[决策者] 语义引擎加载失败: {e}")
            self.semantic_engine = None
        
        # 3. 决策记忆
        self._decision_memory: List[DecisionRecord] = []
        
        # 4. 分析缓存
        self._analysis_cache = {}
        
        # 5. 路由统计
        self._route_stats = {"A": 0, "B": 0, "C": 0}

    def _load_memory(self):
        """加载历史决策记忆"""
        try:
            import json
            from pathlib import Path
            memory_file = Path(f"data/users/{self.user_id}/decision_memory.json")
            if memory_file.exists():
                with open(memory_file) as f:
                    data = json.load(f)
                    for item in data[-100:]:
                        self._decision_memory.append(DecisionRecord(**item))
                print(f"[决策者] 加载了 {len(self._decision_memory)} 条历史决策")
        except Exception as e:
            print(f"[决策者] 加载记忆失败: {e}")

    def _save_memory(self):
        """保存决策记忆"""
        try:
            import json
            from pathlib import Path
            memory_file = Path(f"data/users/{self.user_id}/decision_memory.json")
            memory_file.parent.mkdir(parents=True, exist_ok=True)
            with open(memory_file, 'w') as f:
                json.dump([vars(r) for r in self._decision_memory[-200:]], f, indent=2)
        except:
            pass

    # ==================== SmartAgent 抽象方法 ====================
    
    def process(self, user_input: str, context: dict = None) -> dict:
        """SmartAgent 抽象方法实现"""
        return self._decide_and_route(user_input, context)
    
    def _execute_business(self, user_input: str, context: dict = None) -> dict:
        """BusinessAgent 抽象方法实现"""
        return self._decide_and_route(user_input, context)

    # ==================== 核心决策流程 ====================
    
    def _decide_and_route(self, user_input: str, context: dict = None) -> dict:
        """
        多源综合决策与路由
        
        步骤：
        1. 收集所有决策依据
        2. 加权评分
        3. 记录决策
        4. 执行路由
        """
        print(f"[决策者] 🧠 开始多源决策: {user_input[:50]}...")
        
        # Step 1: 收集所有依据
        evidences = self._gather_evidences(user_input, context)
        
        # Step 2: 综合决策
        decision, confidence, reasoning = self._make_decision(evidences)
        
        print(f"[决策者] 📊 最终决策: {decision}")
        print(f"[决策者] 📈 置信度: {confidence:.2%}")
        print(f"[决策者] 💭 推理依据: {reasoning[:100]}...")
        
        # Step 3: 记录决策
        self._record_decision(user_input, decision, confidence)
        
        # Step 4: 更新统计
        self._route_stats[decision] = self._route_stats.get(decision, 0) + 1
        
        # Step 5: 执行路由
        route_result = self._route(decision, user_input)
        
        # Step 6: 更新执行结果（用于学习）
        success = route_result.get("success", False)
        self._update_memory(user_input, decision, success)
        
        # Step 7: 添加决策元数据
        if isinstance(route_result, dict):
            route_result["decision_metadata"] = {
                "decision": decision,
                "confidence": confidence,
                "reasoning": reasoning,
                "evidences": {
                    "analyst": evidences.get("analyst", {}).get("suggested_route"),
                    "semantic": evidences.get("semantic", {}).get("suggestion"),
                    "llm": evidences.get("llm_suggestion"),
                    "historical": evidences.get("historical"),
                },
                "route_stats": self._route_stats
            }
        
        return route_result

    # ==================== 证据收集 ====================
    
    def _gather_evidences(self, user_input: str, context: dict = None) -> Dict:
        """收集所有决策依据"""
        evidences = {
            "analyst": None,      # 分析师报告
            "semantic": None,     # 语义引擎
            "llm_suggestion": None,  # LLM 建议
            "historical": None,   # 历史经验
            "heuristic": 0.0      # 启发规则分数
        }
        
        # 1. 分析师报告（权重 40%）
        evidences["analyst"] = self._get_analyst_report(user_input, context)
        print(f"[决策者] 分析师建议: {evidences['analyst'].get('suggested_route') if evidences['analyst'] else 'N/A'}")
        
        # 2. 语义引擎（权重 25%）
        evidences["semantic"] = self._get_semantic_suggestion(user_input)
        if evidences["semantic"]:
            print(f"[决策者] 语义建议: {evidences['semantic'].get('suggestion')}")
        
        # 3. LLM 建议（权重 20%）
        evidences["llm_suggestion"] = self._get_llm_suggestion(user_input)
        if evidences["llm_suggestion"]:
            print(f"[决策者] LLM 建议: {evidences['llm_suggestion']}")
        
        # 4. 历史经验（权重 10%）
        evidences["historical"] = self._get_historical_suggestion(user_input)
        if evidences["historical"]:
            print(f"[决策者] 历史建议: {evidences['historical']}")
        
        # 5. 启发规则（权重 5%）
        evidences["heuristic"] = self._get_heuristic_score(user_input)
        
        return evidences

    def _get_analyst_report(self, user_input: str, context: dict = None) -> dict:
        """获取分析师报告（理解层模式）"""
        try:
            from agents.analysis_agent.agent import analysis_agent
            
            report = analysis_agent.process(
                user_input,
                {"mode": "understanding", "caller": "decision_agent"}
            )
            
            if isinstance(report, dict):
                return {
                    "suggested_route": report.get("suggested_route", "C"),
                    "complexity": report.get("complexity", "medium"),
                    "confidence": report.get("confidence", 0.8),
                    "intent": report.get("intent", "unknown")
                }
        except Exception as e:
            print(f"[决策者] 分析师调用失败: {e}")
        
        return None

    def _get_semantic_suggestion(self, user_input: str) -> Optional[dict]:
        """语义引擎建议"""
        if not self.semantic_engine:
            return None
        
        try:
            result = self.semantic_engine.understand(user_input)
            
            # 意图到路由的映射
            intent_map = {
                "chat": "A", "greeting": "A", "farewell": "A", "thanks": "A",
                "calculate": "B", "weather": "B",
                "analysis": "C", "recommend": "C", "trend": "C"
            }
            
            suggestion = intent_map.get(result.intent, "A")
            return {
                "suggestion": suggestion,
                "intent": result.intent,
                "confidence": result.confidence
            }
        except Exception as e:
            print(f"[决策者] 语义引擎错误: {e}")
            return None

    def _get_llm_suggestion(self, user_input: str) -> Optional[str]:
        """LLM 综合建议"""
        try:
            from core.lib.smart_adapter import smart_adapter
            
            prompt = f"""你是决策顾问。分析任务复杂度，只输出 A、B 或 C。

任务: {user_input}

规则:
- A: 简单聊天、问候、感谢
- B: 单步工具（计算、短翻译、查询）
- C: 复杂任务（分析、写作、多步处理）

只输出字母:"""
            
            result = smart_adapter.generate(prompt, auto_select=True, max_tokens=10)
            result = result.strip().upper()
            
            if result in ["A", "B", "C"]:
                return result
        except Exception as e:
            print(f"[决策者] LLM 建议失败: {e}")
        
        return None

    def _get_historical_suggestion(self, user_input: str) -> Optional[str]:
        """历史经验建议"""
        if not self._decision_memory:
            return None
        
        # 提取关键词
        keywords = user_input[:50]
        success_decisions = []
        
        for record in self._decision_memory:
            if record.result == "success":
                # 简单的关键词匹配
                if any(kw in record.task for kw in keywords.split()[:3] if len(kw) > 2):
                    success_decisions.append(record.decision)
        
        if success_decisions:
            from collections import Counter
            most_common = Counter(success_decisions).most_common(1)
            if most_common:
                return most_common[0][0]
        
        return None

    def _get_heuristic_score(self, user_input: str) -> float:
        """启发规则分数"""
        score = 0.0
        
        # 长文本倾向 C
        if len(user_input) > 100:
            score += 0.3
        
        # 包含特定关键词倾向 C
        complex_keywords = ["分析", "总结", "报告", "写", "趋势"]
        for kw in complex_keywords:
            if kw in user_input.lower():
                score += 0.2
                break
        
        return min(score, 1.0)

    # ==================== 加权决策 ====================
    
    def _make_decision(self, evidences: Dict) -> Tuple[str, float, str]:
        """
        加权综合决策
        
        权重分配:
        - 分析师: 40%
        - 语义引擎: 25%
        - LLM: 20%
        - 历史: 10%
        - 启发: 5%
        """
        scores = {"A": 0.0, "B": 0.0, "C": 0.0}
        reasoning_parts = []
        
        # 1. 分析师权重 40%
        if evidences["analyst"]:
            route = evidences["analyst"].get("suggested_route", "C")
            conf = evidences["analyst"].get("confidence", 0.8)
            scores[route] += 0.4 * conf
            reasoning_parts.append(f"分析师:{route}({conf:.0%})")
        
        # 2. 语义引擎权重 25%
        if evidences["semantic"]:
            route = evidences["semantic"].get("suggestion", "A")
            conf = evidences["semantic"].get("confidence", 0.7)
            scores[route] += 0.25 * conf
            reasoning_parts.append(f"语义:{route}({conf:.0%})")
        
        # 3. LLM 权重 20%
        if evidences["llm_suggestion"]:
            route = evidences["llm_suggestion"]
            scores[route] += 0.20
            reasoning_parts.append(f"LLM:{route}")
        
        # 4. 历史权重 10%
        if evidences["historical"]:
            route = evidences["historical"]
            scores[route] += 0.10
            reasoning_parts.append(f"历史:{route}")
        
        # 5. 启发规则权重 5%
        if evidences["heuristic"] > 0:
            scores["C"] += 0.05 * evidences["heuristic"]
            reasoning_parts.append(f"启发:C({evidences['heuristic']:.0%})")
        
        # 找出最佳决策
        best_decision = max(scores, key=scores.get)
        best_score = scores[best_decision]
        reasoning = " | ".join(reasoning_parts)
        
        print(f"[决策者] 评分: A={scores['A']:.2f}, B={scores['B']:.2f}, C={scores['C']:.2f}")
        
        return best_decision, best_score, reasoning

    # ==================== 决策记忆 ====================
    
    def _record_decision(self, task: str, decision: str, confidence: float):
        """记录决策"""
        record = DecisionRecord(
            task=task[:200],
            decision=decision,
            result="pending",
            confidence=confidence,
            timestamp=datetime.now().isoformat(),
            context={}
        )
        self._decision_memory.append(record)
        self._save_memory()

    def _update_memory(self, task: str, decision: str, success: bool):
        """更新决策结果"""
        for record in reversed(self._decision_memory):
            if record.task == task[:200] and record.decision == decision:
                record.result = "success" if success else "failed"
                record.timestamp = datetime.now().isoformat()
                break
        self._save_memory()

    # ==================== 路由执行 ====================
    
    def _route(self, decision: str, user_input: str) -> dict:
        """执行路由"""
        if decision == "A":
            return self._route_to_chat(user_input)
        elif decision == "B":
            return self._route_to_executor(user_input)
        else:
            return self._route_to_orchestrator(user_input)

    def _route_to_chat(self, message: str) -> dict:
        from agents.chat_agent.agent import chat_agent
        print(f"[决策者] 🚀 路由 → ChatAgent")
        return chat_agent.process(message)

    def _route_to_executor(self, task: str) -> dict:
        from agents.executor_agent.agent import executor_agent
        print(f"[决策者] 🚀 路由 → ExecutorAgent")
        return executor_agent.process(task)

    def _route_to_orchestrator(self, task: str) -> dict:
        from agents.orchestrator.agent import orchestrator_agent
        print(f"[决策者] 🚀 路由 → Orchestrator")
        return orchestrator_agent.process(task, {"caller": "decision_agent"})


decision_agent = DecisionAgent()

    # ========== 决策缓存 ==========
    def _get_decision_cache_key(self, user_input: str) -> str:
        return f"decision:{user_input[:100].strip().lower()}"
    
    def _get_cached_decision(self, cache_key: str):
        try:
            from core.lib.response_cache import response_cache
            # 复用现有 response_cache，但用不同前缀
            return response_cache._cache.get(cache_key)
        except:
            return None
    
    def _cache_decision(self, cache_key: str, decision: str, confidence: float, route_result: dict):
        try:
            from core.lib.response_cache import response_cache
            response_cache._cache[cache_key] = (route_result, time.time())
        except:
            pass

    # ========== 异步证据收集 ==========
    import concurrent.futures
    _executor = concurrent.futures.ThreadPoolExecutor(max_workers=3, thread_name_prefix="decision_")
    
    def _gather_evidences_async(self, user_input: str, context: dict = None) -> Dict:
        """并行收集证据，替代原来的串行方法"""
        from concurrent.futures import as_completed
        import time
        
        evidences = {"heuristic": self._get_heuristic_score(user_input)}
        futures = {}
        
        # 分析师（必须，最重要）
        futures['analyst'] = self._executor.submit(self._get_analyst_report, user_input, context)
        
        # 语义引擎（可选）
        if hasattr(self, 'semantic_engine') and self.semantic_engine:
            futures['semantic'] = self._executor.submit(self._get_semantic_suggestion, user_input)
        
        # 历史经验（可选）
        if hasattr(self, '_decision_memory') and self._decision_memory:
            futures['historical'] = self._executor.submit(self._get_historical_suggestion, user_input)
        
        # 收集结果，每个最多等2秒
        for key, future in futures.items():
            try:
                result = future.result(timeout=2.0)
                if result:
                    evidences[key] = result
            except concurrent.futures.TimeoutError:
                print(f"[决策者] {key} 超时，跳过")
            except Exception as e:
                print(f"[决策者] {key} 失败: {e}")
        
        return evidences
