"""大脑调度器 v3.3.0 - 增强版"""
import json
import re
from datetime import datetime
from core.lib.unified_config import unified_config
from lib.smart_adapter import smart_adapter
from lib.skill_loader_v3 import skill_loader


class DoAnythingSkill:
    """
    大脑调度器 - 智能任务规划与执行
    
    能力:
    1. 数学计算
    2. 记忆查询 (L0-L4)
    3. 报告生成
    4. 自动修复
    5. LLM 智能规划
    6. 任务拆解与编排
    """
    
    name = "do_anything"
    description = "智能大脑：自主规划并组合技能完成任务"
    version = "3.3.0"
    category = "orchestrator"

    def execute(self, params):
        goal = params.get("goal", "")
        if not goal:
            return {"success": False, "error": "需要提供目标"}
        
        # 提取上下文
        context = params.get("context", {})
        user_id = context.get("user_id", "default")
        
        print(f"🧠 [大脑 v{self.version}] 收到任务: {goal[:100]}")

        # 1. 数学计算（最快）
        math_result = self._quick_math(goal)
        if math_result:
            return self._format_response(math_result, "math", goal)

        # 2. 自动修复匹配
        fix_result = self._auto_fix(goal)
        if fix_result:
            return self._format_response(fix_result, "auto_fix", goal)

        # 3. 记忆查询（L0-L4）
        memory_result = self._query_memory(goal, user_id)
        if memory_result and memory_result.get("found"):
            return self._format_response(memory_result, "memory", goal)

        # 4. 报告生成
        if self._is_report(goal):
            report_result = self._generate_report(goal)
            return self._format_response(report_result, "report", goal)

        # 5. LLM 智能规划
        plan_result = self._llm_plan(goal, user_id)
        return self._format_response(plan_result, "llm_plan", goal)

    def _quick_math(self, goal):
        """快速数学计算"""
        pattern = unified_config.get("brain_rules.math.pattern", r'(\d+)\s*([+\-*/])\s*(\d+)')
        match = re.search(pattern, goal.replace('？', '').replace('?', ''))
        if not match:
            return None
        
        a, op, b = int(match.group(1)), match.group(2), int(match.group(3))
        operations = {
            '+': lambda: a + b,
            '-': lambda: a - b,
            '*': lambda: a * b,
            'x': lambda: a * b,
            'X': lambda: a * b,
            '/': lambda: a / b if b != 0 else None
        }
        
        if op in operations:
            result = operations[op]()
            if result is None:
                return {"success": False, "error": "除数不能为0"}
            return {"success": True, "result": result, "expression": f"{a} {op} {b} = {result}"}
        return None

    def _auto_fix(self, goal):
        """自动修复匹配"""
        goal_lower = goal.lower()
        
        # 检查类关键词
        if any(kw in goal_lower for kw in ['检查', '状态', '健康', '运行']):
            if any(kw in goal_lower for kw in ['comfyui', '8188', '生图']):
                return self._execute_skill("auto_fix_comfyui", {"action": "check"})
            if any(kw in goal_lower for kw in ['api', '网关', '5002']):
                return self._execute_skill("auto_fix_api", {"action": "check"})
            if any(kw in goal_lower for kw in ['ollama', 'llm', '11434']):
                return self._execute_skill("auto_fix_llm", {"action": "check"})
        
        # 修复类关键词
        if any(kw in goal_lower for kw in ['修复', 'fix', '重启', '恢复']):
            if any(kw in goal_lower for kw in ['comfyui', 'comfy']):
                return self._execute_skill("auto_fix_comfyui", {"action": "fix"})
            if any(kw in goal_lower for kw in ['api', '网关']):
                return self._execute_skill("auto_fix_api", {"action": "fix"})
            if any(kw in goal_lower for kw in ['ollama', 'llm']):
                return self._execute_skill("auto_fix_llm", {"action": "fix"})
        
        return None

    def _execute_skill(self, skill_name, params):
        """执行技能"""
        try:
            result = skill_loader.execute(skill_name, params)
            return result if result else {"success": False, "error": f"技能 {skill_name} 执行失败"}
        except Exception as e:
            return {"success": False, "error": str(e)}

    def _query_memory(self, goal, user_id):
        """查询记忆 (L0-L4)"""
        query = self._extract_query(goal)
        if not query:
            return None
        
        print(f"📚 [大脑] 查询记忆: {query}")
        
        # L2: 向量记忆检索
        try:
            from lib.memory_vector import vector_memory
            results = vector_memory.search(query, n=5, category="conversation", where={"user_id": user_id})
            if results:
                return {
                    "success": True,
                    "found": True,
                    "source": "L2_vector",
                    "query": query,
                    "count": len(results),
                    "results": results
                }
        except Exception as e:
            print(f"向量记忆查询失败: {e}")
        
        # L1: 短期记忆（如果L2没有结果）
        try:
            memory_file = f"data/users/{user_id}/butler_v2/memory.json"
            import json
            from pathlib import Path
            if Path(memory_file).exists():
                with open(memory_file, 'r') as f:
                    data = json.load(f)
                preferences = data.get('preferences', {})
                if preferences:
                    return {
                        "success": True,
                        "found": True,
                        "source": "L1_short_term",
                        "preferences": preferences
                    }
        except Exception as e:
            print(f"短期记忆查询失败: {e}")
        
        return {"success": True, "found": False, "query": query}

    def _is_report(self, goal):
        """判断是否是报告请求"""
        keywords = unified_config.get("brain_rules.report.keywords", 
                                       ['报告', '汇报', '总结', '统计', '分析'])
        return any(kw in goal for kw in keywords)

    def _generate_report(self, goal):
        """生成报告"""
        topic = goal
        for kw in ['生成', '写', '做', '报告', '汇报', '总结']:
            topic = topic.replace(kw, '')
        topic = topic.strip()
        if not topic:
            topic = "系统运行报告"
        
        print(f"📊 [大脑] 生成报告: {topic}")
        
        # 收集数据
        report_data = {
            "topic": topic,
            "timestamp": datetime.now().isoformat(),
            "sections": []
        }
        
        # 添加系统信息
        try:
            import psutil
            report_data["sections"].append({
                "title": "系统状态",
                "content": f"CPU: {psutil.cpu_percent()}%, 内存: {psutil.virtual_memory().percent}%"
            })
        except:
            pass
        
        # 添加俱乐部统计
        try:
            from core.butler_club import butler_club
            stats = butler_club.get_stats()
            report_data["sections"].append({
                "title": "俱乐部统计",
                "content": f"会员: {stats.get('total_members', 0)}, 交互: {stats.get('total_interactions', 0)}"
            })
        except:
            pass
        
        return {"success": True, "report": report_data}

    def _extract_query(self, goal):
        """提取查询关键词"""
        stopwords = unified_config.get("brain_rules.memory_query.stopwords",
                                        ['查询', '搜索', '帮我', '查一下', '看看', '请问', '什么', '多少'])
        query = goal
        for w in stopwords:
            query = query.replace(w, '')
        query = query.strip()
        
        if not query or len(query) < 2:
            # 默认查询
            if '成功率' in goal:
                return '成功率'
            elif '健康' in goal:
                return '健康状态'
            elif 'todo' in goal.lower():
                return '待办'
            return '系统状态'
        return query

    def _llm_plan(self, goal, user_id):
        """LLM 智能规划"""
        print(f"🤖 [大脑] LLM 规划: {goal[:50]}...")
        
        # 获取可用技能
        skills = list(skill_loader.skills.keys())
        
        prompt = f"""你是一个智能任务规划器。用户目标: {goal}

可用技能: {skills[:30]}

请输出JSON格式的计划:
{{"skill": "技能名称", "params": {{}}, "reasoning": "为什么选择这个技能"}}

如果没有合适技能，输出:
{{"direct": true, "response": "直接回答用户", "reasoning": "直接回复的原因"}}"""

        try:
            response = smart_adapter.generate(prompt, auto_select=True)
            match = re.search(r'\{.*\}', response, re.DOTALL)
            if match:
                plan = json.loads(match.group())
                if plan.get('direct'):
                    return {"success": True, "response": plan.get('response', ''), "plan_type": "direct"}
                
                skill_name = plan.get("skill")
                params = plan.get("params", {})
                if skill_name and skill_name in skills:
                    result = skill_loader.execute(skill_name, params)
                    if result and result.get('success'):
                        return {"success": True, "result": result, "plan_type": "skill", "skill_used": skill_name}
        except Exception as e:
            print(f"LLM规划失败: {e}")
        
        # 降级：直接 LLM 回答
        try:
            direct_response = smart_adapter.generate(goal, auto_select=True)
            return {"success": True, "response": direct_response, "plan_type": "fallback"}
        except Exception as e:
            return {"success": False, "error": f"执行失败: {e}"}

    def _format_response(self, result, source, original_goal):
        """格式化响应"""
        response = {
            "success": result.get("success", True),
            "source": source,
            "original_goal": original_goal[:100],
            "timestamp": datetime.now().isoformat()
        }
        
        if "result" in result:
            response["result"] = result["result"]
        if "expression" in result:
            response["expression"] = result["expression"]
        if "response" in result:
            response["response"] = result["response"]
        if "report" in result:
            response["report"] = result["report"]
        if "found" in result:
            response["found"] = result["found"]
        if "count" in result:
            response["count"] = result["count"]
        
        return response


# 技能实例
skill = DoAnythingSkill()
