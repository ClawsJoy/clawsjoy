# ClawsJoy 环境变量配置
# 复制此文件为 .env 并填入实际值

# JWT 配置
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRE_HOURS=24

# LLM 配置
LLM_ENDPOINT=http://localhost:5012/chat
LLM_MODEL=qwen2.5:3b

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/gateway.log

# 安全配置
MAX_REQUEST_SIZE=10485760
RATE_LIMIT=100
