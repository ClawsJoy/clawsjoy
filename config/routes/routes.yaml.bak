# ========== 技能市场路由 ==========
- path: /api/marketplace/upload
  method: GET
  handler: marketplace_upload
  enabled: true
  description: 上传技能到市场（开发者）

- path: /api/marketplace/review
  method: GET
  handler: marketplace_review
  enabled: true
  description: 审核技能（管理员）

- path: /api/marketplace/list
  method: GET
  handler: marketplace_list
  enabled: true
  description: 市场技能列表

# ========== 管理路由 ==========
- path: /api/admin/agents
  method: GET
  handler: admin_list_agents
  enabled: true
  description: 管理员 - 列出所有 Agent

- path: /api/admin/agents/toggle
  method: GET
  handler: admin_toggle_agent
  enabled: true
  description: 管理员 - 启用/禁用 Agent

- path: /api/admin/reload
  method: GET
  handler: admin_reload_config
  enabled: true
  description: 管理员 - 热重载配置

# ========== 学习路由 ==========
- path: /api/learning/stats
  method: GET
  handler: learning_stats
  enabled: true
  description: 学习统计

- path: /api/learning/trigger
  method: GET
  handler: learning_trigger
  enabled: true
  description: 触发学习

# ========== 反馈路由 ==========
- path: /api/feedback/submit
  method: GET
  handler: feedback_submit
  enabled: true
  description: 提交反馈

- path: /api/feedback/stats
  method: GET
  handler: feedback_stats
  enabled: true
  description: 反馈统计

# ========== 申请类型说明（文档） ==========
# 申请 type 支持的值:
# - export: 数据导出
# - delete: 数据删除
# - migrate: 数据迁移
# - developer_apply: 开发者角色申请
# - skill_upload: 技能上传权限申请
# - api_key: API Key 申请
- path: /api/agents/send
  method: GET
  handler: agent_message
  enabled: true
  description: 发送消息到 Agent

