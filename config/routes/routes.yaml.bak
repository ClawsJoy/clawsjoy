knowledge:
- description: 语义搜索知识
  handler: knowledge_search
  method: GET
  path: /api/v5/knowledge/search
- description: 添加知识条目
  handler: knowledge_add
  method: GET
  path: /api/v5/knowledge/add
- description: 知识库统计
  handler: knowledge_stats
  method: GET
  path: /api/v5/knowledge/stats

routes:
- description: 检查服务健康状态，返回服务是否正常运行
