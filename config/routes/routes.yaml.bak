  method: GET
  path: /api/health
- description: 获取系统中所有可用技能的列表
  enabled: true
  handler: list_skills
  method: GET
  path: /api/skills
- description: 执行指定的技能，传入参数获取结果
  enabled: true
  handler: execute_skill
  method: GET
  path: /api/skills/execute
- path: /api/hot_reload_skills
