{
  "name": "clawsjoy-client",
  "version": "4.0.0",
  "description": "ClawsJoy 智能体AI系统桌面客户端",
  "author": "ClawsJoy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.clawsjoy.app",
    "productName": "ClawsJoy",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "static/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["AppImage", "snap"],
      "category": "Utility"
    },
    "files": [
      "main.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*"
    ]
  }
}
