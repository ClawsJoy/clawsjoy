# ========== 工作流路由 ==========
@register("execute_workflow")
def execute_workflow():
    from lib.workflow_executor import get_workflow_executor
    data = request.json
    executor = get_workflow_executor()
    result = executor.execute_workflow(data.get('workflow', ''), data.get('input', {}))
    return jsonify(result)

@register("auto_workflow")
def auto_workflow():
    from lib.workflow_executor import get_workflow_executor
    data = request.json
    executor = get_workflow_executor()
    workflow_name = executor.get_workflow_by_keyword(data.get('text', ''))
    if workflow_name:
        result = executor.execute_workflow(workflow_name, {"user_input": data.get('text', '')})
        return jsonify(result)
    return jsonify({"success": False, "message": "未找到匹配的工作流"})

@register("workflow_status")
def workflow_status():
    from lib.workflow_executor import get_workflow_executor
    executor = get_workflow_executor()
    result = executor.get_status(request.args.get('workflow_id'))
    return jsonify(result)


# ========== 认证路由 ==========
@register("auth_register")
def auth_register():
    from lib.auth_api import auth_manager
    data = request.json
    result = auth_manager.register(
        username=data.get('username', ''),
        password=data.get('password', ''),
        role=data.get('role', 'user')
    )
    return jsonify(result)

@register("auth_login")
def auth_login():
    from lib.auth_api import auth_manager
    data = request.json
    result = auth_manager.login(
        username=data.get('username', ''),
        password=data.get('password', '')
    )
    return jsonify(result)

@register("auth_verify")
def auth_verify():
    from lib.auth_api import auth_manager
    token = request.headers.get('Authorization', '').replace('Bearer ', '')
    payload = auth_manager.verify_token(token)
    if payload:
        return jsonify({"valid": True, "user": payload})
    return jsonify({"valid": False}), 401


