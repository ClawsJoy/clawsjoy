"""路由处理器注册中心 - ClawsJoy 配置驱动"""

from flask import jsonify, request, send_from_directory
from lib.skill_loader_v3 import skill_loader
from lib.agent_registry import agent_registry
from lib.agent_communication import agent_comm
from lib.log_aggregator import log_aggregator
import os

# 处理器注册表
HANDLERS = {}

def register(name):
    """装饰器：注册处理器"""
    def decorator(func):
        HANDLERS[name] = func
        return func
    return decorator


# ========== Web 路由 ==========
@register("web_index")
def web_index():
    return send_from_directory('../renderer', 'index_root.html')

@register("web_static")
def web_static(filename):
    return send_from_directory('../renderer', filename)


# ========== 系统路由 ==========
@register("health")
def health():
    return jsonify({"service": "gateway", "status": "ok", "version": "4.0.0"})

@register("admin_health")
def admin_health():
    return jsonify({"service": "gateway", "status": "ok", "version": "4.0.0", "admin": True})


# ========== 技能路由 ==========
@register("list_skills")
def list_skills():
    skills = skill_loader.list_skills()
    return jsonify({"skills": skills, "total": len(skills)})

@register("execute_skill")
def execute_skill():
    data = request.json
    result = skill_loader.execute(data.get('skill'), data.get('params', {}))
    return jsonify(result)

@register("do_anything")
def do_anything():
    from skills.core.do_anything import skill
    data = request.json
    result = skill.execute({"goal": data.get('goal', '')})
    return jsonify(result)

@register("skill_search")
def skill_search():
    keyword = request.args.get('q', '')
    skills = skill_loader.search_skills(keyword)
    return jsonify({"skills": skills, "total": len(skills)})


# ========== Agent 路由 ==========
@register("list_agents")
def list_agents():
    agents = agent_registry.list_all()
    return jsonify({"agents": agents, "total": len(agents)})

@register("agents_health")
def agents_health():
    result = {}
    for name, info in agent_registry.list_all().items():
        result[name] = {"status": info.get("status", "unknown")}
    return jsonify({"agents": result})

@register("agents_info")
def agents_info():
    return jsonify({"agents": list(agent_registry.list_all().keys())})

@register("get_agent_messages")
def get_agent_messages():
    agent_id = request.args.get('agent')
    messages = agent_comm.get_messages(agent_id)
    return jsonify({"messages": messages, "count": len(messages)})

@register("send_agent_message")
def send_agent_message():
    data = request.json
    msg_id = agent_comm.send(data.get('from', 'user'), data.get('to'), {"message": data.get('message')})
    return jsonify({"message_id": msg_id})

@register("broadcast_message")
def broadcast_message():
    data = request.json
    msg_id = agent_comm.send_broadcast(data.get('from', 'system'), data.get('event_type'), data.get('payload', {}))
    return jsonify({"success": True, "message_id": msg_id})

@register("subscribe_agent")
def subscribe_agent():
    data = request.json
    agent_comm.subscribe(data.get('agent_id'), data.get('event_type'))
    return jsonify({"success": True})


# ========== 聊天路由 ==========
@register("chat")
def chat():
    from core.agents.personal_butler_v2 import PersonalButlerV2
    from core.agents.chat_agent import chat_agent
    data = request.json
    user_id = data.get('user_id', 'default')
    message = data.get('message', '')
    user_role = data.get('user_role', 'guest')
    session_id = data.get('session_id', None)
    personal_butler = PersonalButlerV2(user_id=user_id)
    if not message:
        return jsonify({"error": "消息为空", "success": False}), 400
    if user_role == 'guest':
        result = chat_agent.process(message, session_id)
    else:
        result = personal_butler.process(message)
    return jsonify({
        "response": result.get('response', ''),
        "success": result.get('success', True),
        "session_id": result.get('session_id')
    })


# ========== 日志路由 ==========
@register("get_logs")
def get_logs():
    service = request.args.get('service')
    lines = int(request.args.get('lines', 50))
    logs = log_aggregator.get_logs(service, lines)
    return jsonify({"logs": logs})

@register("search_logs")
def search_logs():
    keyword = request.args.get('q', '')
    service = request.args.get('service')
    lines = int(request.args.get('lines', 20))
    results = log_aggregator.search_logs(keyword, service, lines)
    return jsonify({"results": results})

@register("get_errors")
def get_errors():
    service = request.args.get('service')
    lines = int(request.args.get('lines', 50))
    errors = log_aggregator.get_errors(service, lines)
    return jsonify({"errors": errors})


# ========== 服务路由 ==========
@register("list_services")
def list_services():
    return jsonify({"services": {"gateway": {"port": 5002, "status": "running"}}})

@register("metrics")
def metrics():
    return jsonify({"metrics": {}})


# ========== Agent 消息 API ==========
@register("agent_message")
def agent_message(agent_name):
