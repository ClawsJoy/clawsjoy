    return jsonify(agent_knowledge.get_stats())

@register("knowledge_sync")
def knowledge_sync():
    from lib.agent_knowledge import agent_knowledge
    agent_knowledge.sync_all()
    return jsonify({"success": True, "message": "同步完成"})


# ========== 翻译路由 ==========
@register("translate_query")
def translate_query():
    data = request.json
    text = data.get('text', '')
    target = data.get('target', 'zh')
    return jsonify({"success": True, "translated": f"[翻译] {text}", "source": "mock"})


# ========== 用户路由 ==========
@register("user_config_get")
def user_config_get():
    user_id = request.args.get('user_id', 'default')
    return jsonify({"config": {}, "user_id": user_id})

@register("user_config_set")
def user_config_set():
