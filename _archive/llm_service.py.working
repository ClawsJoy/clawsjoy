#!/usr/bin/env python3
import requests
from flask import Flask, request, jsonify

app = Flask(__name__)

# 硬编码，确保不被配置覆盖
MODEL = "phi3:mini"
OLLAMA_URL = "http://localhost:11434"

@app.route("/health", methods=["GET"])
def health():
    return jsonify({"status": "ok", "model": MODEL})

@app.route("/chat", methods=["POST"])
def chat():
    data = request.json or {}
    message = data.get("message", "")
    if not message:
        return jsonify({"response": "", "success": False})
    
    try:
        resp = requests.post(
            f"{OLLAMA_URL}/api/generate",
            json={"model": MODEL, "prompt": message, "stream": False},
            timeout=60
        )
        if resp.status_code == 200:
            result = resp.json()
            return jsonify({"response": result.get("response", ""), "success": True})
        return jsonify({"response": "服务错误", "success": False})
    except Exception as e:
        return jsonify({"response": str(e), "success": False})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5012)
