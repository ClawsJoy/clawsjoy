"""决策 Agent - 处理决策和任务分发"""
from typing import Dict, Optional
from core.agents.base.smart_agent import SmartAgent


class DecisionAgent(SmartAgent):
    """决策助手 Agent"""

    name = "decision_agent"
    description = "智能决策与建议"
    type = "core"

    def on_init(self):
        """初始化"""
        self.log("决策 Agent 初始化完成")

    def process(self, user_input: str, context: Optional[Dict] = None) -> Dict:
        """处理用户输入"""
        self._update_stats()
        
        # 简单的优先级判断
        high_keywords = ["紧急", "重要", "critical", "urgent"]
        medium_keywords = ["建议", "优化", "improve"]
        
        if any(kw in user_input for kw in high_keywords):
            response = "这是一个高优先级任务，建议立即处理。"
        elif any(kw in user_input for kw in medium_keywords):
            response = "这是一个中等优先级任务，可以安排在计划中。"
        else:
            response = "我可以帮您分析问题和提供建议。"
        
        self.record_interaction(user_input, response)
        
        return {
            "success": True,
            "response": response,
            "user_id": self.user_id
        }
