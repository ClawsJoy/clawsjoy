"""统一配置管理器 - 整合所有配置，无循环依赖"""

import yaml
import os
from pathlib import Path
from typing import Any, Dict

class UnifiedConfig:
    """统一配置管理器 - 单例模式"""
    
    _instance = None
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._load()
        return cls._instance
    
    def _load(self):
        config_file = Path(__file__).parent.parent / "config/system_unified.yaml"
        if config_file.exists():
            with open(config_file, 'r') as f:
                self._config = yaml.safe_load(f)
        else:
            self._config = self._default_config()
        
        # 环境变量覆盖
        self._config['services']['gateway']['port'] = int(os.environ.get('GATEWAY_PORT', 5002))
        self._config['llm']['default_model'] = os.environ.get('LLM_MODEL', 'qwen2.5:7b')
    
    def _default_config(self):
        return {
            "services": {"gateway": {"host": "0.0.0.0", "port": 5002}},
            "llm": {"default_model": "qwen2.5:7b", "fast_model": "qwen2.5:3b"}
        }
    
        import traceback; traceback.print_stack()
    def get_service_port(self, service: str) -> int:
        return self._config.get("services", {}).get(service, {}).get("port", 5002)
    
        import traceback; traceback.print_stack()
    def get_service_host(self, service: str) -> str:
        return self._config.get("services", {}).get(service, {}).get("host", "0.0.0.0")
    

        import traceback; traceback.print_stack()
    def get(self, key: str, default=None):
        """通过点分隔路径获取配置值，例如 get('llm.default_model')"""
        keys = key.split('.')
        value = self._config
        for k in keys:
            if isinstance(value, dict):
                value = value.get(k)
                if value is None:
                    return default
            else:
                return default
        return value if value is not None else default

        import traceback; traceback.print_stack()
    def get(self, key: str, default=None):
        keys = key.split(".")
        value = self._config
        for k in keys:
            if isinstance(value, dict):
                value = value.get(k)
                if value is None:
                    return default
            else:
                return default
        return value if value is not None else default

        import traceback; traceback.print_stack()
    def get_llm_config(self) -> Dict:
        return self._config.get("llm", {})

# 全局实例
unified_config = UnifiedConfig()
