    """待办管理"""
    from flask import request, session
    data = request.json
    user_id = session.get('user_id', data.get('user_id', 'default'))
    action = data.get('action', 'list')
    todo = data.get('todo', {})
    
    butler = get_butler(user_id)
    
    if action == 'add':
        butler.memory['todos'].append({
            "id": len(butler.memory['todos']) + 1,
            "content": todo.get('content'),
            "due": todo.get('due'),
            "status": "pending",
            "created_at": datetime.now().isoformat()
        })
        butler._save_data()
        return jsonify({"success": True, "todos": butler.memory['todos']})
    elif action == 'complete':
        todo_id = todo.get('id')
        for t in butler.memory['todos']:
            if t.get('id') == todo_id:
                t['status'] = 'completed'
        butler._save_data()
        return jsonify({"success": True})
    else:
        return jsonify({"todos": butler.memory['todos']})

