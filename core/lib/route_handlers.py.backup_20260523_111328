                    "text": params.get('requirement', ''),
                    "style": params.get('style', 'manhua')
                })
                return jsonify({"success": True, "code": result.get('video_url', ''), "message": "视频生成中"})
            else:
                return jsonify({"success": True, "response": "视频创作大师已就绪，请说“帮我制作漫剧视频”"})
