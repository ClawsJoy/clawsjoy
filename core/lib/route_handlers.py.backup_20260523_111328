@register("knowledge_sync")
def knowledge_sync():
    """同步所有知识到向量中心"""
    from flask import jsonify
    from lib.vector_knowledge_center import vector_knowledge
    from lib.skill_loader_v3 import skill_loader
    
    # 同步技能
    skills = skill_loader.list_skills()
    synced = 0
    for skill_name in skills:
        try:
            skill_obj = skill_loader.get_skill(skill_name)
            description = getattr(skill_obj, 'description', f'{skill_name} 技能')
            
            vector_knowledge.add_skill(skill_name, {
                "category": "general",
                "description": description,
                "keywords": skill_name
            })
            synced += 1
        except:
            pass
    
    return jsonify({
        "success": True,
        "synced": synced,
        "total": len(skills),
        "message": f"已同步 {synced}/{len(skills)} 个技能到向量知识中心"
    })

