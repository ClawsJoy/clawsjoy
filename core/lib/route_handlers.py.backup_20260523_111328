    return jsonify({"tenants": tenant_manager.list_tenants()})

@register("create_tenant")
def create_tenant():
    """创建租户"""
    from lib.tenant_manager import tenant_manager
    data = request.json
    result = tenant_manager.create_tenant(
        tenant_id=data.get('tenant_id'),
        name=data.get('name')
    )
    return jsonify(result)

@register("get_tenant_quota")
def get_tenant_quota():
    """获取租户配额"""
    from lib.tenant_manager import tenant_manager
    from flask import g
    tenant_id = request.args.get('tenant_id') or getattr(g, 'tenant_id', 'default')
    return jsonify({"quota": tenant_manager.get_tenant_quota(tenant_id)})
