@register("agent_message")
def agent_message(agent_name):
    """接收发送给 Agent 的消息 - 带实际业务处理"""
    data = request.json
    message_id = data.get('message_id')
    topic = data.get('topic')
    content = data.get('content', {})
    sender = data.get('sender')
    
    print(f"📨 [{agent_name}] 收到来自 {sender} 的消息: {topic}")
    
    result = {
        "status": "received",
        "message_id": message_id,
        "agent": agent_name,
        "topic": topic,
        "processed": True
    }
    
    # 根据不同的 Agent 执行实际业务逻辑
    if agent_name == 'video_agent':
        # 调用视频制作技能
        try:
            from lib.skill_loader_v3 import skill_loader
            
            action = content.get('action', 'create')
            params = content.get('params', {})
            
            if action == 'create' or topic == 'task.video.create':
                # 调用 manju_maker 技能
                skill_result = skill_loader.execute('manju_maker', params)
                result['skill_result'] = skill_result
                result['message'] = '视频已生成'
            elif action == 'subtitle' or topic == 'task.video.subtitle':
                # 调用 add_subtitles 技能
                skill_result = skill_loader.execute('add_subtitles', params)
                result['skill_result'] = skill_result
                result['message'] = '字幕已添加'
            else:
                result['message'] = f'视频Agent收到: {content}'
        except Exception as e:
            result['error'] = str(e)
            result['message'] = '技能调用失败'
            
    elif agent_name == 'code_agent':
        # 调用代码生成技能
        try:
            from lib.skill_loader_v3 import skill_loader
            
            action = content.get('action', 'generate')
            params = content.get('params', {})
            
            if action == 'generate':
                # 调用 code_agent 相关技能
                skill_result = skill_loader.execute('smart_execute', params)
                result['skill_result'] = skill_result
                result['message'] = '代码已生成'
            else:
                result['message'] = f'代码Agent收到: {content}'
        except Exception as e:
            result['error'] = str(e)
            result['message'] = '技能调用失败'
            
    elif agent_name == 'analysis_agent':
        result['message'] = f'分析Agent收到: {content}'
        
    elif agent_name == 'orchestrator':
        # 编排器：根据任务分发给其他 Agent
        task_type = content.get('task_type', 'unknown')
        task_content = content.get('task', {})
        
        if task_type == 'video':
            # 转发给 video_agent
            from lib.agent_bus import get_bus
            bus = get_bus()
            bus.publish('orchestrator', 'task.video.create', {
                'action': 'create',
                'params': task_content,
                'original_sender': sender
            })
            result['forwarded_to'] = 'video_agent'
        elif task_type == 'code':
            from lib.agent_bus import get_bus
            bus = get_bus()
            bus.publish('orchestrator', 'task.code.generate', {
                'action': 'generate',
                'params': task_content,
                'original_sender': sender
            })
            result['forwarded_to'] = 'code_agent'
        else:
            result['message'] = f'编排器收到: {content}'
            
    else:
        result['message'] = f'消息已收到，{agent_name} 将处理'
    
    return jsonify(result)

