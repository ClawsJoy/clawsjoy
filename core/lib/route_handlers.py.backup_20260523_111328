    """科幻风格主页面"""
    from flask import send_file
    import os
    from pathlib import Path
    # 使用 normpath 规范化路径
    current_dir = os.path.dirname(__file__)
    web_dir = os.path.normpath(os.path.join(current_dir, '..', 'web'))
