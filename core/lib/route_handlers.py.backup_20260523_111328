@register("user_skill_config")
def user_skill_config():
    """获取/更新技能配置"""
    from flask import request, jsonify
    from lib.user_config import get_user_config
    
    user_id = request.args.get('user_id', 'default')
    skill_name = request.args.get('skill', '')
    
    if not skill_name:
        return jsonify({"error": "请提供技能名"}), 400
    
    config = get_user_config(user_id)
    
    if request.method == 'POST':
        # 更新配置
        data = request.json
        config.update_skill_config(skill_name, data.get('config', {}))
        return jsonify({"success": True, "skill": skill_name})
    
    # GET 获取配置
    skill_config = config.get_skill_config(skill_name)
    return jsonify({"skill": skill_name, "config": skill_config})

@register("user_config_v2_get")
def user_config_v2_get():
    """获取用户配置（分层）"""
    from flask import request, jsonify
    from lib.user_config_v2 import get_user_config_v2
    
    user_id = request.args.get('user_id', 'default')
    layer = request.args.get('layer', 'custom')  # system_base, custom, private
    
    config = get_user_config_v2(user_id)
    
    if layer == 'system_base':
        return jsonify({"layer": "system_base", "readonly": True, "config": config.get_system_base()})
    elif layer == 'custom':
        return jsonify({"layer": "custom", "config": config.get_custom()})
    elif layer == 'private':
        return jsonify({"layer": "private", "readonly": False, "config": config.get_private()})
    else:
        return jsonify({
            "system_base": config.get_system_base(),
            "custom": config.get_custom(),
            "stats": config.get_stats()
        })

