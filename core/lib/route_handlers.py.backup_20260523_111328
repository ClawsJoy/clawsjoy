        "quality_score": 85
    })

@register("code_execute")
def code_execute():
    """CODE Agent - 执行代码"""
    from flask import request, jsonify
    import tempfile
    from pathlib import Path
    
    data = request.json
    code = data.get('code', '')
    
    temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.html', delete=False)
    temp_file.write(code)
    temp_file.close()
    
    return jsonify({
        "success": True,
        "file_path": temp_file.name,
        "message": f"代码已保存到 {temp_file.name}"
    })

@register("skill_search")
def skill_search():
    """向量搜索技能"""
    from flask import request, jsonify
    from lib.skill_search import skill_search
    
    query = request.args.get('q', '')
    n = int(request.args.get('n', 10))
    
    if not query:
        return jsonify({"error": "请提供搜索词"}), 400
    
    results = skill_search.search(query, n=n)
    
    # 过滤技能相关结果
    skills = []
    for r in results:
        if r.get('metadata', {}).get('category') == 'skill':
            skills.append({
                "name": r['metadata'].get('skill_name', 'unknown'),
                "content": r['document'][:200],
                "score": r.get('distance', 0)
            })
    
    return jsonify({"query": query, "results": skills, "total": len(skills)})

