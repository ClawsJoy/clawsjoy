# 处理器注册表
HANDLERS = {}

def register(name):
    """装饰器：注册处理器"""
    def decorator(func):
        HANDLERS[name] = func
        return func
    return decorator


# ========== Web 路由 ==========
@register("web_index")
def web_index():
    return send_from_directory('../renderer', 'index_root.html')

@register("web_static")
def web_static(filename):
    return send_from_directory('../renderer', filename)


