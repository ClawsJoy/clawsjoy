# ========== 私人管家独立 API 处理器 ==========
    """私人管家对话"""
    from flask import request, jsonify, g
    from core.agents.personal_butler_v2 import PersonalButlerV2
    
    data = request.get_json()
    message = data.get('message', '')
    user_id = data.get('user_id', g.get('user_id', 'default'))
    
    if not message:
        return jsonify({"error": "消息为空", "success": False}), 400
    
    butler = PersonalButlerV2(user_id=user_id)
    result = butler.process(message)
    
    return jsonify({
        "response": result.get('response', ''),
        "success": result.get('success', True),
        "user_id": user_id
    })

@register("butler_rename")
def butler_rename():
    """管家改名"""
    from flask import request, jsonify, g
    from core.agents.personal_butler_v2 import PersonalButlerV2
    
    data = request.get_json() or {}
    new_name = data.get('name', '')
    user_id = data.get('user_id', g.get('user_id', 'default'))
    
    if not new_name:
        return jsonify({"success": False, "error": "name required"}), 400
    
    butler = PersonalButlerV2(user_id=user_id)
    
    # 直接调用 rename 方法
    result = butler.rename(new_name)
    
    return jsonify({
        "response": result.get('response', f'好的，以后请叫我 {new_name}'),
        "success": result.get('success', True),
        "new_name": new_name,
        "user_id": user_id
    })
