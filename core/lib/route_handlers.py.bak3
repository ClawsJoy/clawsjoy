# ========== 缺失的处理器（桩函数） ==========
# ========== 技能市场处理器（直接实现，避免循环导入） ==========

class _SecurityScanner:
    """技能安全扫描器"""
    @staticmethod
    def scan_skill(skill_code: str) -> dict:
        dangerous_patterns = [
            "import os", "subprocess", "eval", "exec", "__import__",
            "open(", "file(", "sys.", "shutil.", "rm ", "del "
        ]
        issues = [p for p in dangerous_patterns if p in skill_code]
        return {"safe": len(issues) == 0, "issues": issues}

@register("marketplace_upload")
def marketplace_upload():
    """上传技能到市场（带安全扫描）"""
    from flask import request, jsonify
    from pathlib import Path
    import json
    import uuid
    from datetime import datetime
    from lib.config_helper import get_data_root
    
    data = request.get_json() or {}
    skill_id = data.get('skill_id', str(uuid.uuid4())[:8])
    skill_code = data.get('code', '')
    skill_name = data.get('name', '')
    description = data.get('description', '')
    author = data.get('author', 'developer')
    
    if not skill_code:
        return jsonify({"success": False, "error": "code required"}), 400
    
    # 安全扫描
    scan_result = _SecurityScanner.scan_skill(skill_code)
    if not scan_result['safe']:
        return jsonify({
            "success": False,
            "error": "技能安全扫描未通过",
            "issues": scan_result['issues']
        }), 400
    
    # 保存待审核
    pending_dir = Path(f"{get_data_root()}/marketplace/pending")
    pending_dir.mkdir(parents=True, exist_ok=True)
    
    skill_data = {
        "id": skill_id,
        "name": skill_name,
        "description": description,
        "code": skill_code,
        "author": author,
        "status": "pending",
        "created_at": datetime.now().isoformat(),
        "scan_result": scan_result
    }
    
    with open(pending_dir / f"{skill_id}.json", 'w') as f:
        json.dump(skill_data, f, indent=2)
    
    return jsonify({
        "success": True,
        "message": "技能已提交审核",
        "skill_id": skill_id,
        "scan_result": scan_result
    })

@register("marketplace_review")
def marketplace_review():
    """管理员审核技能"""
    from flask import request, jsonify
    from pathlib import Path
    import json
    from datetime import datetime
    from lib.config_helper import get_data_root
    
    data = request.get_json() or {}
    skill_id = data.get('skill_id', '')
    action = data.get('action', '')
    comment = data.get('comment', '')
    
    if not skill_id or action not in ['approve', 'reject']:
        return jsonify({"success": False, "error": "skill_id and action (approve/reject) required"}), 400
    
    pending_dir = Path(f"{get_data_root()}/marketplace/pending")
    pending_file = pending_dir / f"{skill_id}.json"
    
    if not pending_file.exists():
        return jsonify({"success": False, "error": "技能不存在"}), 404
    
    with open(pending_file, 'r') as f:
        skill_data = json.load(f)
    
    if action == "approve":
        skill_data['status'] = 'approved'
        skill_data['review_comment'] = comment
        skill_data['reviewed_at'] = datetime.now().isoformat()
        
        marketplace_dir = Path(f"{get_data_root()}/marketplace")
        marketplace_dir.mkdir(parents=True, exist_ok=True)
        
        with open(marketplace_dir / f"{skill_id}.json", 'w') as f:
            json.dump(skill_data, f, indent=2)
        
        pending_file.unlink()
        
        return jsonify({
            "success": True,
            "message": "技能已审核通过",
            "skill_id": skill_id
        })
    else:
        pending_file.unlink()
        return jsonify({
            "success": True,
            "message": "技能已拒绝",
            "skill_id": skill_id
        })
