@register("guest_token")
def guest_token():
    """获取游客 token"""
    from flask import request, jsonify
    from lib.guest_token_manager import guest_token_manager
    import time
    
    data = request.get_json() or {}
    old_token = data.get('token')
    
    if old_token:
        session = guest_token_manager.renew_session(old_token)
    else:
        session = guest_token_manager.create_session()
    
    return jsonify({
        "success": True,
        "token": session["token"],
        "user_id": session["user_id"],
        "expires_in": int(session["expires_at"] - time.time())
    })

@register("chat_with_token")
def chat_with_token():
    """带 token 的聊天接口（游客使用）"""
    from flask import request, jsonify
    from core.agents.chat_agent import chat_agent
    from lib.guest_token_manager import guest_token_manager
    
    data = request.get_json() or {}
    message = data.get('message', '')
    token = data.get('token', '')
    
    if not message:
        return jsonify({"error": "message required"}), 400
    
    # 验证 token
    if token:
        session = guest_token_manager.validate_token(token)
        if not session:
            return jsonify({
                "success": False,
                "error": "token_expired",
                "need_refresh": True
            }), 401
    
    result = chat_agent.process(message)
    
    # 记录交互
    if token and result.get('success'):
        guest_token_manager.record_interaction(token, message, result.get('response', ''))
    
    return jsonify(result)

