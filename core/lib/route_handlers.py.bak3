@register("butler_todo")
def butler_todo():
    """管家待办管理 - 支持 GET/POST"""
    from core.agents.personal_butler_v2 import PersonalButlerV2
    from flask import request, jsonify, g
    
    # 获取 user_id
    user_id = None
    if request.method == 'GET':
        user_id = request.args.get('user_id')
    elif request.method == 'POST':
        data = request.get_json() or {}
        user_id = data.get('user_id')
    
    user_id = user_id or g.get('user_id', 'default')
    
    if request.method == 'GET':
        # 获取待办列表
        butler = PersonalButlerV2(user_id=user_id)
        todos = butler.get_todos()
        return jsonify({"success": True, "todos": todos, "user_id": user_id})
    
    elif request.method == 'POST':
        data = request.get_json() or {}
        task = data.get('task', '')
        
        if not task:
            return jsonify({"success": False, "error": "task required"}), 400
        
        butler = PersonalButlerV2(user_id=user_id)
        butler.add_todo(task)
        todos = butler.get_todos()
        
        return jsonify({"success": True, "message": "已添加待办", "todos": todos, "user_id": user_id})
    
    return jsonify({"success": False, "error": "Method not allowed"}), 405
