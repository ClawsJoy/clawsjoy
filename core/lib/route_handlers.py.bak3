@register("admin_list_agents")
def admin_list_agents():
    """管理员 - 列出所有 Agent"""
    from flask import jsonify
    from core.agents.agent_manager import agent_manager
    
    agents = agent_manager.list_agents()
    return jsonify({
        "success": True,
        "agents": agents,
        "total": len(agents)
    })

@register("admin_toggle_agent")
def admin_toggle_agent():
    """管理员 - 启用/禁用 Agent"""
    from flask import request, jsonify
    from core.agents.agent_manager import agent_manager
    
    data = request.get_json() or {}
    name = data.get('name')
    enabled = data.get('enabled', True)
    
    if not name or name not in agent_manager.agents:
        return jsonify({"success": False, "error": "Agent not found"}), 404
    
    agent_manager.agents[name]['enabled'] = enabled
    agent_manager._save()
    
    return jsonify({
        "success": True,
        "message": f"Agent {name} 已{'启用' if enabled else '禁用'}"
    })

@register("admin_reload_config")
def admin_reload_config():
    """管理员 - 热重载配置"""
    from flask import jsonify
    from lib.route_registry import route_registry
    from lib.config_auto_watcher import config_auto_watcher
    
    route_registry.reload()
    config_auto_watcher.scan_and_register()
    
    return jsonify({
        "success": True,
        "message": "配置已热重载"
    })

# ========== 学习处理器 ==========
@register("learning_stats")
def learning_stats():
    """学习统计"""
    from flask import jsonify
    from core.learner.self_learning_coordinator import SelfLearningCoordinator
    
    coordinator = SelfLearningCoordinator()
    return jsonify({
        "success": True,
        "stats": coordinator.stats
    })

@register("learning_trigger")
def learning_trigger():
    """触发学习"""
    from flask import request, jsonify
    from core.learner.self_learning_coordinator import SelfLearningCoordinator
    
    data = request.get_json() or {}
    scenario = data.get('scenario', {})
    
    if not scenario:
        return jsonify({"success": False, "error": "scenario required"}), 400
    
    coordinator = SelfLearningCoordinator()
    result = coordinator.learn_from_scenario(scenario)
    
    return jsonify({
        "success": result.get('success', False),
        "result": result
    })

# ========== 反馈处理器 ==========
@register("feedback_submit")
def feedback_submit():
    """提交反馈"""
    from flask import request, jsonify
    from core.lib.feedback_system import feedback_system
    
    data = request.get_json() or {}
    user_id = data.get('user_id', 'anonymous')
    skill_id = data.get('skill_id', '')
    rating = data.get('rating')
    comment = data.get('comment', '')
    
    if not skill_id or rating is None:
        return jsonify({"success": False, "error": "skill_id and rating required"}), 400
    
    # 记录反馈
    feedback_system.update_satisfaction(user_id, {skill_id: rating})
    
    return jsonify({
        "success": True,
        "message": "反馈已提交"
    })

@register("feedback_stats")
def feedback_stats():
    """反馈统计"""
    from flask import jsonify
    from core.lib.feedback_system import feedback_system
    
    stats = feedback_system.get_stats()
    return jsonify({
        "success": True,
        "stats": stats
    })


