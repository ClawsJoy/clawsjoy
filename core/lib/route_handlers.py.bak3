@register("marketplace_list_products")
def marketplace_list_products():
    """市场产品列表 - 从配置文件加载"""
    import json
    from pathlib import Path
    
    # 从 market_data 加载产品
    products = marketplace_data.list_products()
    
    # 同时兼容原有的 marketplace 目录
    marketplace_dir = Path(f"{get_data_root()}/marketplace")
    for f in marketplace_dir.glob("*.json"):
        if f.name == "alice_purchases.json":
            continue
        try:
            with open(f, 'r', encoding='utf-8') as fp:
                data = json.load(fp)
                # 如果还没有被加载，添加
                if not any(p.get("id") == data.get("id") for p in products):
                    products.append({
                        "id": data.get("id", f.stem),
                        "name": data.get("name", f.stem),
                        "type": data.get("type", "agent"),
                        "version": data.get("version", "1.0.0"),
                        "description": data.get("description", ""),
                        "price": data.get("price", "free")
                    })
        except Exception:
            pass
    
    return jsonify({"success": True, "products": products, "total": len(products)})
@register("marketplace_install_agent")
def marketplace_install_agent():
    """安装 Agent - 镜像安装到用户目录"""
    data = request.get_json() or {}
    product_id = data.get('product_id') or data.get('agent_id')
    user_id = data.get('user_id', 'default')
    
    if not product_id:
        return jsonify({"success": False, "error": "product_id required"}), 400
    
    # 获取产品信息
    product = marketplace_data.get_product(product_id)
    if not product:
        # 尝试从 marketplace 目录直接读取
        product_file = Path(f"{get_data_root()}/marketplace/{product_id}.json")
        if product_file.exists():
            import json
            with open(product_file, 'r') as f:
                product = json.load(f)
    
    if not product:
        return jsonify({"success": False, "error": "Product not found"}), 404
    
    # 创建用户工作区
    user_agent_dir = Path(f"{get_data_root()}/users/{user_id}/agents/{product_id}")
    user_agent_dir.mkdir(parents=True, exist_ok=True)
    
    # 复制产品配置到用户目录
    import shutil
    product_file = Path(f"{get_data_root()}/marketplace/{product_id}.json")
    if product_file.exists():
        shutil.copy(product_file, user_agent_dir / "product.json")
    
    # 记录安装信息
    import json
    from datetime import datetime
    install_info = {
        "product_id": product_id,
        "name": product.get("name", product_id),
        "version": product.get("version", "1.0.0"),
        "installed_at": datetime.now().isoformat(),
        "user_id": user_id
    }
    with open(user_agent_dir / ".installed", 'w') as f:
        json.dump(install_info, f, indent=2)
    
    return jsonify({"success": True, "message": f"Agent {product_id} 已安装", "path": str(user_agent_dir)})
@register("marketplace_my_agents")
def marketplace_my_agents():
    """我的 Agents - 从用户目录加载已安装的Agent"""
    user_id = request.args.get('user_id', 'default')
    
    user_agents_dir = Path(f"{get_data_root()}/users/{user_id}/agents")
    agents = []
    
    if user_agents_dir.exists():
        for agent_dir in user_agents_dir.iterdir():
            if agent_dir.is_dir():
                info = {
                    "id": agent_dir.name,
                    "name": agent_dir.name,
                    "path": str(agent_dir),
                    "installed_at": None
                }
                # 读取购买信息
                purchase_file = agent_dir / ".purchase_info"
                if purchase_file.exists():
                    try:
                        import json
                        with open(purchase_file, 'r') as f:
                            purchase = json.load(f)
                            info.update(purchase)
                    except Exception:
                        pass
                agents.append(info)
    
    return jsonify({"success": True, "agents": agents})
@register("marketplace_uninstall")
def marketplace_uninstall():
    """卸载 Agent"""
    data = request.get_json() or {}
    agent_id = data.get('agent_id') or data.get('product_id')
    user_id = data.get('user_id', 'default')
    
    if not agent_id:
        return jsonify({"success": False, "error": "agent_id required"}), 400
    
    user_agent_dir = Path(f"{get_data_root()}/users/{user_id}/agents/{agent_id}")
    
    if user_agent_dir.exists():
        import shutil
        shutil.rmtree(user_agent_dir)
        return jsonify({"success": True, "message": f"Agent {agent_id} 已卸载"})
    else:
        return jsonify({"success": False, "error": "Agent not found"}), 404
