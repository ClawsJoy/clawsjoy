        json.dump(template, f, indent=2)
    
    return jsonify({"success": True, "message": "模板已提交审核"})


@register("workflow_template_review")
def workflow_template_review():
    """管理员审核工作流模板"""
    from flask import request, jsonify
    
    data = request.get_json() or {}
    template_id = data.get('template_id', '')
    action = data.get('action', '')
    
    pending_dir = Path("data/workflow_templates/pending")
    pending_file = pending_dir / f"{template_id}.json"
    
    if not pending_file.exists():
        return jsonify({"success": False, "error": "模板不存在"}), 404
    
    with open(pending_file, 'r') as f:
        template = json.load(f)
    
    if action == "approve":
        template['status'] = 'approved'
        templates_dir = Path("data/workflow_templates")
        with open(templates_dir / f"{template_id}.json", 'w') as f:
            json.dump(template, f, indent=2)
        pending_file.unlink()
        return jsonify({"success": True, "message": "模板已审核通过"})
    
    elif action == "reject":
        pending_file.unlink()
        return jsonify({"success": True, "message": "模板已拒绝"})
    
    return jsonify({"success": False, "error": "无效操作"}), 400


