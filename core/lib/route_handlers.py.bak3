@register("admin_create_agent")
def admin_create_agent():
    """管理员 - 创建 Agent"""
    from flask import request, jsonify
    from core.agents.agent_manager import agent_manager
    
    data = request.get_json() or {}
    name = data.get('name')
    
    if not name:
        return jsonify({"success": False, "error": "name required"}), 400
    
    # 添加到配置
    agent_manager.agents[name] = data
    agent_manager._save()
    
    return jsonify({
        "success": True,
        "message": f"Agent {name} 已创建"
    })

@register("admin_update_agent")
def admin_update_agent():
    """管理员 - 更新 Agent"""
    from flask import request, jsonify
    from core.agents.agent_manager import agent_manager
    
    data = request.get_json() or {}
    name = data.get('name')
    
    if not name or name not in agent_manager.agents:
        return jsonify({"success": False, "error": "Agent not found"}), 404
    
    agent_manager.agents[name].update(data)
    agent_manager._save()
    
    return jsonify({
        "success": True,
        "message": f"Agent {name} 已更新"
    })

@register("admin_toggle_agent")
def admin_toggle_agent():
    """管理员 - 启用/禁用 Agent"""
    from flask import request, jsonify
    from core.agents.agent_manager import agent_manager
    
    data = request.get_json() or {}
    name = data.get('name')
    enabled = data.get('enabled', True)
    
    if not name or name not in agent_manager.agents:
        return jsonify({"success": False, "error": "Agent not found"}), 404
    
    agent_manager.agents[name]['enabled'] = enabled
    agent_manager._save()
    
    return jsonify({
        "success": True,
        "message": f"Agent {name} 已{'启用' if enabled else '禁用'}"
    })

@register("admin_delete_agent")
def admin_delete_agent():
    """管理员 - 删除 Agent"""
    from flask import request, jsonify
    from core.agents.agent_manager import agent_manager
    
    data = request.get_json() or {}
    name = data.get('name')
    
    if not name or name not in agent_manager.agents:
        return jsonify({"success": False, "error": "Agent not found"}), 404
    
    del agent_manager.agents[name]
    agent_manager._save()
    
    return jsonify({
        "success": True,
        "message": f"Agent {name} 已删除"
    })

