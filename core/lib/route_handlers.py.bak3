# ========== 热加载API ==========
@register("hot_reload_skills")
def hot_reload_skills():
    """获取租户的热加载技能列表"""
    from core.tenant.hot_reload_manager import hot_reload
    tenant_id = request.args.get('tenant_id', 'default')
    skills = hot_reload.get_tenant_skills(tenant_id)
    return jsonify({"success": True, "skills": skills})

@register("hot_reload_execute")
def hot_reload_execute():
    """执行热加载技能"""
    from core.tenant.hot_reload_manager import hot_reload
    data = request.get_json() or {}
    tenant_id = data.get('tenant_id', 'default')
    skill_id = data.get('skill_id')
    params = data.get('params', {})
    
    if not skill_id:
        return jsonify({"success": False, "error": "skill_id required"}), 400
    
    result = hot_reload.execute_skill(tenant_id, skill_id, params)
    return jsonify(result)

@register("hot_reload_register")
def hot_reload_register():
    """注册新技能（零代码）"""
    from core.tenant.hot_reload_manager import hot_reload
    data = request.get_json() or {}
    tenant_id = data.get('tenant_id', 'default')
    skill_id = data.get('skill_id')
    skill_config = data.get('config', {})
    
    if not skill_id:
        return jsonify({"success": False, "error": "skill_id required"}), 400
    
    result = hot_reload.register_skill(tenant_id, skill_id, skill_config)
    return jsonify({"success": result, "message": "技能已注册并热加载" if result else "注册失败"})

# ========== 本地Agent代理路由 ==========
@register("local_agent_list")
def local_agent_list():
    """列出本地Agent"""
    from core.agent_proxy.local_proxy import local_proxy
    agents = local_proxy.list_agents()
    return jsonify({"success": True, "agents": agents})

@register("local_agent_call")
def local_agent_call():
    """调用本地Agent"""
    from core.agent_proxy.local_proxy import local_proxy
    import asyncio
    
    data = request.get_json() or {}
    agent_id = data.get('agent_id')
    path = data.get('path', '/')
    params = data.get('params', {})
    
    if not agent_id:
        return jsonify({"success": False, "error": "agent_id required"}), 400
    
    # 运行异步请求
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    result = loop.run_until_complete(local_proxy.proxy_request(agent_id, path, params))
    loop.close()
    
    return jsonify(result)

@register("local_agent_register")
def local_agent_register():
    """注册本地Agent"""
    from core.agent_proxy.local_proxy import local_proxy
    data = request.get_json() or {}
    agent_id = data.get('agent_id')
    config = data.get('config', {})
    
    if not agent_id:
        return jsonify({"success": False, "error": "agent_id required"}), 400
    
    result = local_proxy.register_agent(agent_id, config)
    return jsonify(result)

