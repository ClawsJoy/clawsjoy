@register("club_leaderboard")
def club_leaderboard():
    """获取会员排行榜（按交互次数）"""
    from flask import jsonify
    from core.butler_club import butler_club
    import json
    from pathlib import Path
    
    members_dir = butler_club.data_root / 'members'
    leaderboard = []
    
    if members_dir.exists():
        for user_dir in members_dir.iterdir():
            if user_dir.is_dir():
                profile_file = user_dir / 'profile.json'
                if profile_file.exists():
                    with open(profile_file, 'r') as f:
                        member = json.load(f)
                        leaderboard.append({
                            "user_id": member.get('user_id'),
                            "butler_name": member.get('butler_name'),
                            "total_interactions": member.get('total_interactions', 0),
                            "membership_level": member.get('membership_level', 'bronze')
                        })
    
    # 按交互次数排序
    leaderboard.sort(key=lambda x: x['total_interactions'], reverse=True)
    
    return jsonify({
        "success": True,
        "leaderboard": leaderboard[:10]  # 只返回前10名
    })

@register("club_level_info")
def club_level_info():
