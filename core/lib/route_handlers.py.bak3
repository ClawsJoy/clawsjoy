    import yaml
    
    # 直接从配置文件读取
    config_path = Path('config/butler_club.yaml')
    if config_path.exists():
        with open(config_path, 'r') as f:
            config = unified_config.get("route_handlers", {})
            levels = config.get('butler_club', {}).get('membership_levels', [])
    else:
        levels = []
    
    return jsonify({
        "success": True,
        "levels": levels
    })

