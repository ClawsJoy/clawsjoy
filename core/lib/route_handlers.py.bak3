# ========== 会议系统 API ==========
@register("meeting_create")
def meeting_create():
    """创建会议"""
    from flask import request, jsonify
    import traceback
    try:
        from core.agents.meeting_system import meeting_system, MeetingLevel
        data = request.json or {}
        
        # 构建正确的 issue 格式
        issue = {
            "type": data.get('type', 'general'),
            "description": data.get('topic', ''),
            "details": data.get('details', {})
        }
        
        # 映射 level
        level_map = {
            'info': MeetingLevel.INFO,
            'warning': MeetingLevel.WARNING,
            'critical': MeetingLevel.CRITICAL,
            'emergency': MeetingLevel.EMERGENCY
        }
        level_str = data.get('level', 'info')
        level = level_map.get(level_str, MeetingLevel.INFO)
        
        result = meeting_system.trigger_meeting(issue=issue, level=level)
        return jsonify({"success": True, "meeting_id": result.get("id") if result else None})
    except Exception as e:
        print(f"会议API错误: {e}")
        traceback.print_exc()
        return jsonify({"success": False, "error": str(e)}), 500
    except Exception as e:
        print(f"会议API错误: {e}")
        traceback.print_exc()
        return jsonify({"success": False, "error": str(e)}), 500


