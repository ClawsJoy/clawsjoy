@register("list_tenants")
def list_tenants():
    """列出所有租户"""
    from pathlib import Path
    tenants_dir = Path(f"{get_data_root()}/tenants")
    tenants = [d.name for d in tenants_dir.iterdir() if d.is_dir()] if tenants_dir.exists() else []
    return jsonify({"tenants": tenants})

