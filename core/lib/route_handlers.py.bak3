    tenant_id = data.get('tenant_id', 'default')
    
    if not query:
        return jsonify({"success": False, "error": "query required"}), 400
    
    result = matcher.match(query)
    return jsonify(result)


@register("user_data_request")
def user_data_request():
    """用户数据申请（客户端申请窗口）"""
    from flask import request, jsonify
    from datetime import datetime
    
    data = request.get_json() or {}
    user_id = data.get('user_id', '')
    request_type = data.get('type', 'export')  # export / delete / migrate
    reason = data.get('reason', '')
    
    # 保存申请记录
    request_file = Path(f"{get_data_root()}/user_requests/{user_id}_{datetime.now().timestamp()}.json")
    request_file.parent.mkdir(parents=True, exist_ok=True)
    
    request_data = {
        "user_id": user_id,
        "type": request_type,
        "reason": reason,
        "status": "pending",
        "created_at": datetime.now().isoformat()
    }
    
    with open(request_file, 'w') as f:
        json.dump(request_data, f, indent=2)
    
    return jsonify({
        "success": True,
        "message": "申请已提交，等待管理员审核",
        "request_id": request_file.stem
    })


@register("user_data_request_list")
def user_data_request_list():
    """管理员查看申请列表"""
    from flask import request, jsonify
    
    requests_dir = Path(f"{get_data_root()}/user_requests")
    if not requests_dir.exists():
        return jsonify({"success": True, "requests": []})
    
    requests_list = []
    for f in requests_dir.glob("*.json"):
        with open(f, 'r') as fp:
            requests_list.append(json.load(fp))
    
    return jsonify({"success": True, "requests": requests_list})


@register("user_data_request_approve")
def user_data_request_approve():
    """管理员审核申请"""
    from flask import request, jsonify
    from lib.user_data_manager import get_user_data
    
    data = request.get_json() or {}
    request_id = data.get('request_id', '')
    action = data.get('action', '')  # approve / reject
    
    request_file = Path(f"{get_data_root()}/user_requests/{request_id}.json")
    if not request_file.exists():
        return jsonify({"success": False, "error": "申请不存在"}), 404
    
    with open(request_file, 'r') as f:
        req_data = json.load(f)
    
    if action == "approve":
        user_data = get_user_data(req_data['user_id'])
        
        if req_data['type'] == 'export':
            # 执行导出
            export_path = user_data.user_root / "export"
            user_data.export_all(export_path)
            return jsonify({"success": True, "message": "数据已准备导出", "export_path": str(export_path)})
        
        req_data['status'] = 'approved'
        req_data['approved_at'] = datetime.now().isoformat()
        
    elif action == "reject":
        req_data['status'] = 'rejected'
    
    with open(request_file, 'w') as f:
        json.dump(req_data, f, indent=2)
    
    return jsonify({"success": True, "message": f"申请已{action}"})


