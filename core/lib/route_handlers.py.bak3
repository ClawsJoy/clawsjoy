@register("agent_message")
def agent_message(agent_name):
    """向指定 Agent 发送消息（路径参数）"""
    from flask import request, jsonify, g
    import importlib
    
    data = request.get_json() or {}
    message = data.get('message', '')
    user_id = data.get('user_id', g.get('user_id', 'default'))
    
    if not message:
        return jsonify({"success": False, "error": "message required"}), 400
    
    # Agent 类名映射

    agent_class_map = {
        'chat_agent': 'ChatAgent',
        'code_agent': 'CodeAgent', 
        'decision_agent': 'DecisionAgent',
        'orchestrator': 'OrchestratorAgent',
        'analysis_agent': 'AnalysisAgent',
        'collector_agent': 'CollectorAgent',
        'life_cycle_agent': 'LifeCycleAgent',
        'personal_butler_v2': 'PersonalButlerV2',
        'copywriter_agent': 'CopywriterAgent',
    }
    
    class_name = agent_class_map.get(agent_name)
    if not class_name:
        return jsonify({"success": False, "error": f"Unknown agent: {agent_name}"}), 400
    
    try:
        module = importlib.import_module(f"core.agents.{agent_name}")
        agent_class = getattr(module, class_name)
        agent = agent_class(user_id=user_id)
        result = agent.process(message)
        return jsonify({
            "success": result.get('success', True),
            "response": result.get('response', ''),
            "user_id": user_id
        })
    except Exception as e:
        import traceback
        traceback.print_exc()
        return jsonify({"success": False, "error": str(e)}), 500

@register("chain_of_thought")
def chain_of_thought():
    """思维链推理"""
    from core.llm_enhanced import llm_enhanced
    from core.prompt_engineer import prompt_engineer
    
    data = request.get_json() or {}
    question = data.get('question', '')
    
    if not question:
        return jsonify({"error": "question required"}), 400
    
    prompt = prompt_engineer.reasoning_prompt(question)
    response = llm_enhanced.generate(prompt, temperature=0.3)
    
    return jsonify({"success": True, "response": response})


# ========== 向量记忆 API ==========
@register("vector_search")
def vector_search():
    """向量语义搜索"""
    from flask import request, jsonify
    from core.old.vector_memory import get_vector_memory
    
    data = request.get_json() or {}
    user_id = data.get('user_id', 'default')
    query = data.get('query', '')
    limit = data.get('limit', 5)
    
    if not query:
        return jsonify({"success": False, "error": "query required"}), 400
    
    memory = get_vector_memory(user_id)
    results = memory.search(query, limit)
    
    return jsonify({"success": True, "results": results, "user_id": user_id})


@register("vector_add")
def vector_add():
    """添加向量记忆"""
    from flask import request, jsonify
    from core.old.vector_memory import get_vector_memory
    
    data = request.get_json() or {}
    user_id = data.get('user_id', 'default')
    text = data.get('text', '')
    metadata = data.get('metadata', {})
    
    if not text:
        return jsonify({"success": False, "error": "text required"}), 400
    
    memory = get_vector_memory(user_id)
    doc_id = memory.add(text, metadata)
    
    return jsonify({"success": True, "doc_id": doc_id, "user_id": user_id})

# ========== 知识中心处理器 ==========
def knowledge_search():
    """知识库语义搜索"""
    from flask import request, jsonify
    try:
        from lib.knowledge_registry import knowledge_registry
        data = request.get_json() or {}
        query = data.get('query', '')
        category = data.get('category')
        n = data.get('n', 5)
        
        if not query:
            return jsonify({"success": False, "error": "query required"}), 400
        
        results = knowledge_registry.search(query, category, n)
        return jsonify({"success": True, "results": results})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)}), 500

def knowledge_add():
    """添加知识条目"""
    from flask import request, jsonify
    try:
        from lib.knowledge_registry import knowledge_registry
        data = request.get_json() or {}
        title = data.get('title', '')
        content = data.get('content', '')
