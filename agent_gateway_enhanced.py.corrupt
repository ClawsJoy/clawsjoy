# ========== 配置 ==========
DATA_DIR = Path("data")
MEMORY_FILE = DATA_DIR / "memory_simple.json"
LEARNING_FILE = DATA_DIR / "learning_data" / "learning_stats.json"
WORKFLOW_DIR = Path("workflows")
TEMPLATES_DIR = Path("templates")
MEMORY_FILE.parent.mkdir(parents=True, exist_ok=True)
(DATA_DIR / "learning_data").mkdir(parents=True, exist_ok=True)

# ========== 记忆和学习函数（复用之前的） ==========
def load_memories(user_id):
    if MEMORY_FILE.exists():
        with open(MEMORY_FILE, 'r') as f:
            all_memories = json.load(f)
            return all_memories.get(user_id, [])
    return []

def save_memory(user_id, fact):
    """保存记忆到文件和向量库"""
    memories = load_memories(user_id)
    memories.append({
        'fact': fact,
        'timestamp': datetime.now().isoformat()
    })
    
    all_memories = {}
    if MEMORY_FILE.exists():
        with open(MEMORY_FILE, 'r') as f:
            all_memories = json.load(f)
    
    all_memories[user_id] = memories[-100:]
    with open(MEMORY_FILE, 'w') as f:
        json.dump(all_memories, f, indent=2)
    
    try:
        from core.lib.memory_vector import vector_memory
        vector_memory.add(
            content=fact,
            metadata={"user_id": user_id, "type": "conversation"},
            category=f"user_{user_id}"
        )
    except Exception as e:
        pass
    
    # 向量存储
    try:
        from core.lib.memory_vector import vector_memory
        vector_memory.add(
            content=fact,
            metadata={
                "user_id": user_id,
                "type": "conversation",
                "timestamp": datetime.now().isoformat()
            },
            category=f"user_{user_id}"
        )
    except Exception as e:
        print(f"向量存储失败: {e}")

def search_memories(user_id, query):
    """检索相关记忆 - 增强版"""
    memories = load_memories(user_id)
    results = []
    query_lower = query.lower()
    
    for m in memories:
        fact = m.get('fact', '')
        # 如果是问名字，优先找包含"叫"的记忆
        if '名字' in query_lower or '叫什么' in query_lower:
            if '叫' in fact and '用户说' in fact:
                results.append(fact)
        # 通用匹配
        elif any(kw in query_lower for kw in ['什么', '哪', '多少']):
            for word in query_lower.split():
                if len(word) > 1 and word in fact.lower():
                    results.append(fact)
                    break
        elif query_lower in fact.lower():
            results.append(fact)
    
    return results[:10]

def load_learning_stats():
    if LEARNING_FILE.exists():
        with open(LEARNING_FILE, 'r') as f:
            data = json.load(f)
            if isinstance(data, dict):
                if 'total_learnings' not in data:
                    data['total_learnings'] = data.get('learned', 0)
                return data
    return {"total_learnings": 0, "successful_learnings": 0, "failed_learnings": 0}

def record_learning(fact, success=True):
    stats = load_learning_stats()
    stats['total_learnings'] = stats.get('total_learnings', 0) + 1
    if success:
        stats['successful_learnings'] = stats.get('successful_learnings', 0) + 1
    else:
        stats['failed_learnings'] = stats.get('failed_learnings', 0) + 1
    with open(LEARNING_FILE, 'w') as f:
        json.dump(stats, f, indent=2)

